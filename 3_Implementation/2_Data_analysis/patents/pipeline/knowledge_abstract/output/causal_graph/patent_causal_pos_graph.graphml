  <data key="d7">[{"pat_id": "US-4896542-A", "para_id": "para_7", "text": "sewers that carry wastewater from areas that experience severe storm water inflow problems typically operate under surcharged conditions during and immediately after rainfall events"}, {"pat_id": "US-RE36069-E", "para_id": "para_7", "text": "sewers that carry wastewater from areas that experience severe storm water inflow problems typically operate under surcharged conditions during and immediately after rainfall events"}, {"pat_id": "US-7022243-B2", "para_id": "para_44", "text": "in the event of a heavy storm where there is a high flow of storm water the separation tank 10 of the present invention also functions to convey the additional flow of water into a separate high flow treatment chamber so as to circumvent the second treatment chamber 36 thereby preventing any scour or resuspension of previously captured material from the second chamber and filter recharge chamber"}]</data>
