  <data key="d5">["center", "activation", "wastewater", "device", "position", "wheel", "time", "module", "load", "flange", "tank", "use", "water", "generating", "addition", "member", "portion", "end", "cost", "bucket", "culture", "frame", "bar", "rim", "contact", "oxygen", "microorganism", "amount", "flow", "turnover", "decrease", "body", "edge"]</data>
  <data key="d6">["separate", "include", "purify", "support", "prevent", "supply", "connect", "use", "form", "dissolve", "clean", "reflect", "optimize", "increase", "rotate", "pass", "have", "reduce", "shape", "can", "be", "adjust", "generate", "lift"]</data>
  <data key="d7">[{"pat_id": "KR-102228305-B1", "para_id": "para_7", "text": "as the amount of dissolved oxygen is increased by supplying it to the microorganism culture tank for a long time the wastewater is purified by optimizing the activation of microorganisms.in addition when the amount of dissolved oxygen decreases during long time use the device is lifted and then separated and cleaned to reflect the permanent use thus reducing the cost"}, {"pat_id": "KR-102751616-B1", "para_id": "claim_1", "text": "the above wheel frame is connected by a lifting member so that the underwater position can be adjusted it is formed at the open end of the above bucket body and includes a flange shaped edge portion that can be supported by the above turnover bar the above flange shaped rim portion is formed so that the turnover bar can be supported in contact with the flange shaped rim portion and the bucket body to prevent the bucket module that has passed the top dead center from being reversely rotated due to a reverse load generated from the water flow generating portion"}]</data>
</edge>
