  <data key="d5">["hole", "dam", "valve", "invention", "wastewater", "term", "plant", "people", "season", "treatment", "river", "hour", "size", "process", "population", "example", "facility", "bypass", "flooding", "method", "aeration", "rainfall"]</data>
  <data key="d6">["consider", "instal", "use", "flow", "continue", "can", "construct", "expect", "be", "protect", "cover", "will", "treat", "describe", "block", "provide"]</data>
  <data key="d7">[{"pat_id": "KR-100242042-B1", "para_id": "para_41", "text": "therefore it is considered that it will be easy to construct a small wastewater treatment plant of small to medium size population of 5 000 to 50 000 people .as described above by treating wastewater using the intermittent long term aeration process of the present invention an efficient wastewater treatment method is provided which is economical and can be treated without bypass of wastewater during flooding as well as during rainy and dry seasons"}, {"pat_id": "KR-102816086-B1", "para_id": "para_78", "text": "for example when rainfall continues for more than 1 hour and river flooding is expected a movable dam can be installed in the river and when the movable dam is covered all the holes or valves flowing into or out of the facility are automatically blocked thereby protecting the facility"}]</data>
</edge>
