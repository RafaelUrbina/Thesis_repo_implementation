  <data key="d5">["floor", "complex", "leakage", "earthquake", "outside", "pve", "impact", "point", "pipeline", "system", "diagram", "twist", "function", "purpose", "drain", "resistance", "plate", "damage", "invention", "pipe", "prevention", "tap", "addition", "water", "connection", "pressure", "environment", "unit", "bathroom", "performance", "lot", "drainage", "consumption", "twisting", "manhole", "leak"]</data>
  <data key="d6">["drop", "apply", "improve", "drain", "show", "bury", "provide", "have", "be", "accord", "relate", "use", "figure", "prevent", "live", "occur"]</data>
  <data key="d7">[{"pat_id": "JP-5529803-B2", "para_id": "para_3", "text": "in particular, if water is drained when there is a lot of tap water consumption or when there is a water leak in the water pipeline due to an earthquake, etc., the water pressure in the water pipeline is likely to drop excessively"}, {"pat_id": "KR-102553769-B1", "para_id": "para_1", "text": "it relates to a drainage system of a pve waterproof floor plate with a waterproof function of an earthquake-resistant bathroom to prevent water leakage in addition to preventing leakage"}, {"pat_id": "KR-102553769-B1", "para_id": "para_1", "text": "it is to provide a drainage system of a pve floor plate with a waterproof function of an earthquake-resistant bathroom to prevent water leakage in addition to preventing leakage"}, {"pat_id": "KR-102664616-B1", "para_id": "para_1", "text": "manhole in complex with underground drain pipe connection unit for earthquake resistance and water leak prevention the present invention relates to a manhole in a complex having an underground drain pipe connection unit for earthquake resistance and water leak prevention"}, {"pat_id": "KR-102664616-B1", "para_id": "para_1", "text": "even if an impact is applied from the outside while buried in the pipe, damage can be prevented at the connection between drain pipes, and earthquake resistance and water leak prevention can be used to prevent twisting or water leakage at the connection to the outside"}, {"pat_id": "KR-102664616-B1", "para_id": "para_1", "text": "the purpose is to provide a manhole in the complex with an underground drain pipe connection unit for earthquake resistance and water leak prevention, which can prevent twists or water leaks from occurring at connection points to the outside"}, {"pat_id": "KR-102664616-B1", "para_id": "para_1", "text": "figure 2 is a diagram showing a manhole in a complex with an underground drain pipe connection unit for earthquake resistance and water leak prevention according to the present invention"}, {"pat_id": "KR-102664616-B1", "para_id": "para_1", "text": "therefore, the underground drain pipe connection unit according to the present invention can improve earthquake resistance and water leak prevention performance, providing a safe and comfortable living environment"}]</data>
</edge>
