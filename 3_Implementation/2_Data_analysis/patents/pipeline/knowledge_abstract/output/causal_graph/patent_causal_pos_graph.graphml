  <data key="d7">[{"pat_id": "KR-101582931-B1", "para_id": "claim_1", "text": "the rainwater purification section partition plate 225 and the contaminant separation slope screen 221 are arranged in opposite directions while sloping the contaminant separation slope screen 221 and the rainwater purification partition plate 225 are continuously connected to each other so that the contaminants and rainwater can be easily separated even in a narrow space by the contaminant separation slope screen 221 so that no pollutants accumulate in the city wherein the non point pollution reduction device is a non point pollution reduction device"}, {"pat_id": "KR-101582931-B1", "para_id": "para_86", "text": "the inclined screen causes the rainwater accelerated by the rainwater guiding plate to fall down by the gravity by the rainwater while the obstruction filtered by the screen is sent to the obstacle processing unit 232a at the lower end of the inclined screen the lower end portion is connected to the city gutter through the connection pipe 232 of the city gutter to discharge the habitat of the insect caused by the continuous maintenance and the water gutter phenomenon"}, {"pat_id": "US-11866348-B2", "para_id": "para_124", "text": "this facility is located in a city with extremely high charges for exceeding the cod and tss discharge regulations and the oil grease discharge regulation has a very low threshold 100 ppm"}]</data>
