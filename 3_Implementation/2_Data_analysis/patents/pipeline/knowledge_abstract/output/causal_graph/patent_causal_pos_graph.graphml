k", "mean", "type", "side", "front", "supply", "motor", "generating", "propeller", "sensor", "stop", "button", "sump", "circulation", "port", "tube", "circuit", "operating", "network", "air", "quality", "nozzle", "bolt", "inlet", "control", "connection", "case", "drain", "oxygen", "hook", "isolation", "station", "unit", "board", "input", "hinge", "hood", "worker", "embodiment", "disinfectant", "damage", "disc", "bypass", "body", "flood", "gasket", "solenoid", "brake"]</data>
