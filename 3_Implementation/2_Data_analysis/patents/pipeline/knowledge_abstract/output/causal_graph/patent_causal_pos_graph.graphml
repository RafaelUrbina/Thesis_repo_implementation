  <data key="d5">["opening", "line", "temperature", "mic", "fire", "proliferation", "system", "prevention", "weather", "invention", "breeding", "device", "art", "roof", "convection", "debris", "mean", "therethrough", "freezing", "water", "purpose", "tank", "form", "dwelling", "gathering", "sensor", "designing", "phenomenon", "float", "special", "order", "level", "appliance", "inclement", "warming", "air", "quality", "occurrence", "inside", "mechanism", "winter", "disposal", "heating", "risk", "inlet", "problem", "improvement", "direction", "drain", "ventilation", "microorganism", "rain", "clothe", "hewitt", "rooftop", "flow", "container", "pipe", "summer", "sterilization", "pump"]</data>
  <data key="d6">["drive", "make", "guard", "suppress", "solve", "prevent", "open", "mean", "supply", "arrange", "use", "mount", "describe", "inhibit", "measure", "float", "accord", "extinguish", "remain", "dispense", "locate", "require", "heat", "pass", "have", "improve", "reduce", "cloth", "characterize", "may", "crack", "instal", "activate", "freeze", "circulate", "say", "can", "corrode", "be", "cool", "store", "relate", "permit", "design", "collect", "provide", "comprise"]</data>
  <data key="d7">[{"pat_id": "KR-101627819-B1", "para_id": "para_2", "text": "in order to prevent freezing clothes cloths clothes etc"}, {"pat_id": "US-9765508-B2", "para_id": "para_14", "text": "the hewitt invention is a device to collect and dispense roof rain water comprising a container to collect water having an opening a pump to drive the water out of the container a debris disposal mechanism a sensor to measure the water level wherein the pump is activated at a specific water level"}, {"pat_id": "US-5538043-A", "para_id": "para_38", "text": "similarly use of the invention may permit intermittently seasonally used or occupied appliances and dwellings to remain unheated during inclement weather where continuous heating may ordinarily is required to guard against line freezing"}, {"pat_id": "KR-102036529-B1", "para_id": "para_11", "text": "the present invention has been made to solve the problems according to the prior art described above by heating the water stored in the water tank to be circulated by the convection phenomenon in the summer to cool the water inside the water tank in order to suppress the breeding of microorganisms while improving the water quality of the water stored in the water tank by sterilization in winter the water quality improvement of the roof water tank for extinguishing and preventing freezing by the convection phenomenon by heating the water inside the water tank provided through the main purpose is to"}, {"pat_id": "KR-102036529-B1", "para_id": "para_18", "text": "the present invention relates to a heating device for preventing the water quality improvement and freezing of the water tank 1 installed outdoors that is on the roof for fire extinguishing more specifically the inside of the water tank 1 in the form of a float when floated in water above or below a certain temperature the water inside the water tank 1 is heated to inhibit microbial sterilization as well as proliferation and to prevent freezing so that the water tank 1 and the pipe are corroded by the microorganisms"}, {"pat_id": "KR-102036529-B1", "para_id": "para_18", "text": "water quality improvement and freeze prevention warming device of fire rooftop water tank to prevent the occurrence of mic as well as to prevent the occurrence of water tank 1 and pipe cracking due to freezing of water to supply fire extinguishing water smoothly"}, {"pat_id": "US-6009906-A", "para_id": "para_38", "text": "similarly use of the invention may permit intermittently seasonally used or occupied appliances and dwellings to remain unheated during inclement weather where continuous heating may ordinarily is required to guard against line freezing"}, {"pat_id": "US-4486122-A", "para_id": "claim_1", "text": "characterized in that in order to reduce the risk of freezing of the system special means 5 are mounted in at least some of the drains 1 or other inlets which are so located that the flow of air therethrough can be heavy said means 5 being arranged to reduce such heavy flow of air in both directions through the respective drain but not to prevent some ventilation of the system and designed to permit a small flow of water to pass directly therethrough without appreciable gathering of water in said means and to be automatically opened when required to permit a greater flow of water to pass"}, {"pat_id": "US-4486122-A", "para_id": "claim_6", "text": "characterized by providing special means in at least some of the drains and other inlets which are so located that the flow of air therethrough can be heavy and designing said means to reduce such heavy flow of air in both directions through the respective drain but not to prevent some ventilation of the system and to permit a small flow of water to pass directly therethrough without appreciable gathering of water in said means and to be automatically opened when required to permit a greater flow of water to pass"}]</data>
</edge>
