  <data key="d3">["EP-2099716-B1", "KR-200423906-Y1", "US-9709431-B1", "KR-100715823-B1", "EP-3655743-B1", "US-6834556-B2"]</data>
  <data key="d4">["increase", "determine", "be responsible for", "may", "thus", "therefore"]</data>
  <data key="d5">["temperature", "change", "leakage", "speed", "medium", "system", "mp", "ratio", "weather", "depth", "invention", "precipitation", "instance", "detector", "water", "leak", "barometric", "scour", "sensor", "port", "unity", "base", "level", "segment", "impact", "transport", "bearing", "network", "air", "property", "road", "lack", "example", "joining", "humidity", "control", "wind", "problem", "direction", "sediment", "threshold", "characteristic", "operation", "rain", "spiral", "section", "shear", "flow", "deposition", "container", "sunlight", "rate", "key", "pipe", "conduit", "event", "flooding", "presence", "pressure"]</data>
  <data key="d6">["slow", "include", "join", "solve", "react", "supply", "track", "connect", "indicate", "level", "result", "increase", "devise", "cause", "maximize", "avoid", "have", "control", "improve", "minimize", "occur", "may", "shape", "do", "be", "determine", "describe"]</data>
  <data key="d7">[{"pat_id": "KR-100715823-B1", "para_id": "para_62", "text": "since the conventional conduits 20 21 and 22 are connected by only a simple shear key there is a problem in that there is a lack of unity of segment joining and leakage occurs.thus the present invention has been devised to solve the problems described above if the depth ratio of the precipitation precipitation on the road is small the initial flow rate is minimized by minimizing the deposition of sediment the flow rate for the high flow rate ratio by slowing down avoiding the maximum flow rate the scour is controlled and the section that maximizes the transport flow rate is improved to the oval conduit section by the spiral with the most optimal hydraulic characteristics and the same as the streamlined l shaped port and conduit"}, {"pat_id": "EP-2099716-B1", "para_id": "para_78", "text": "the medium is supplied above the maximum water level of the container and the medium has not yet reacted with the mp and therefore no precipitation occur in the pipe and also resulting in a minimum impact from precipitations on the bearings 19"}, {"pat_id": "EP-3655743-B1", "para_id": "para_92", "text": "for instance recent precipitation or flooding events may be responsible for the changes which do not indicate the presence of a water network leak"}, {"pat_id": "US-9709431-B1", "para_id": "para_59", "text": "in this example if the rain sensor indicates that there is no local precipitation but that there are water levels above a threshold the control system 100 may track property operations to determine if there is a problematic operation that may be causing water leakage within the property"}, {"pat_id": "KR-200423906-Y1", "para_id": "para_62", "text": "since the conventional conduits 20 21 and 22 are connected by only a simple shear key there is a problem in that there is a lack of unity of the segment joining and leakage occurs.therefore the present invention was devised to solve the problems described above and when the depth ratio of precipitation precipitation on the road is small the initial flow rate is increased to minimize the deposition of sediment and the flow rate is increased for the flow rate with a high depth ratio"}, {"pat_id": "US-6834556-B2", "para_id": "para_59", "text": "for example base sensors may include chemical detectors and weather sensors that indicate the air temperature wind speed wind direction precipitation sunlight levels humidity barometric pressure or other environmental properties"}]</data>
</edge>
