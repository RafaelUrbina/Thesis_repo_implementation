  <data key="d5">["hole", "opening", "rainwater", "pollutant", "medium", "component", "system", "sedimentation", "invention", "device", "effluent", "side", "water", "part", "tank", "treatment", "reason", "capacity", "runoff", "matter", "target", "end", "volume", "aspect", "contaminant", "purity", "inlet", "filtration", "fluid", "reservoir", "separator", "peak", "unit", "shape", "liquid", "flow", "oil", "apparatus", "factor", "monitoring", "outlet", "removal", "body", "rainfall", "fine", "processing"]</data>
  <data key="d6">["enable", "sweep", "separate", "include", "accumulate", "combine", "purify", "treat", "provide", "compare", "meet", "deposit", "form", "accord", "result", "filter", "improve", "have", "reduce", "would", "may", "flow", "bring", "be", "store", "describe", "instal", "comprise"]</data>
  <data key="d7">[{"pat_id": "KR-101138988-B1", "para_id": "para_7", "text": "as described above the present invention enables to filter the contaminants to be swept into the runoff such as rainwater through the porous media while improving the processing capacity compared to the conventional water contaminant removal device"}, {"pat_id": "KR-101113989-B1", "para_id": "para_5", "text": "a first treatment part 230 formed in a shape and including a rainwater separator 234 for separating the effluent and the oil component and a sedimentation tank 238 formed under the solid separator 232 to store the solid matter a first inlet hole 202 is formed so that the effluent treated by the first treatment unit 230 flows in a filtration sedimentation reservoir for depositing contaminants included in the effluent is formed and fines for purifying fine contaminants and effluents"}, {"pat_id": "US-8808497-B2", "para_id": "para_5", "text": "water and other fluids often accumulate various contaminants and it is often desirable or necessary to separate the fluid from the contaminant to meet various purity targets or reduce the volume of liquid within an open reservoir which may be necessary for practical legal or other reasons"}, {"pat_id": "US-7780855-B2", "para_id": "para_7", "text": "these two factors combined would result in greater total contaminants being brought to the separator tank during peak flows"}, {"pat_id": "KR-101959509-B1", "para_id": "para_23", "text": "according to an aspect of the present invention there is provided a monitoring system for a rainfall runoff pollutant filtration apparatus comprising a rainfall runoff having an opening at an upper end thereof an outlet formed at one or more sides of the lower runoff the filtration unit is installed inside the main body and filters rainwater effluent flowing into the opening"}]</data>
</edge>
