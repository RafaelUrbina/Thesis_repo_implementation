  <data key="d4">["drive", "due to", "to prevent", "may"]</data>
  <data key="d5">["drive", "subsidence", "impeller", "minute", "gap", "mbr", "disk", "membrane", "invention", "precipitation", "blade", "construction", "rotation", "coagulation", "time", "side", "supply", "water", "tank", "motor", "plurality", "measure", "treatment", "addition", "phenomenon", "capacity", "carbon", "sludge", "order", "polymer", "ground", "portion", "bearing", "end", "breakage", "shaft", "coagulant", "floc", "separation", "problem", "direction", "contact", "plate", "stirring", "apparatus", "pipe", "storage", "method", "agglomeration", "object", "pressure"]</data>
  <data key="d6">["drive", "mention", "guide", "include", "make", "settle", "support", "apply", "solve", "provide", "prevent", "interfere", "take", "connect", "cause", "rotate", "have", "occur", "may", "stir", "activate", "do", "be", "twist", "describe", "generate"]</data>
  <data key="d7">[{"pat_id": "KR-100713774-B1", "para_id": "para_25", "text": "is settled in the bearing which interferes with smooth rotation thereby causing breakage of the apparatus including the rotating shaft and the driving motor.summary of the invention the present invention has been made in order to solve the above mentioned problems and it is an object of the present invention to provide an impeller disk plate which rotates in a storage tank water and prevents precipitation of sludge the bearing is provided at a lower end side rotating portion of the rotating shaft so as to support and guide the rotating drive"}, {"pat_id": "KR-100472947-B1", "para_id": "para_23", "text": "the first coagulation stir motor 320a and the second coagulation stir motor 320b rotate 60 times per minute to prevent breakage of the large coagulation floc generated by contact with the polymer coagulant and the first coagulation stir shaft 322a and a second agglomeration stirring shaft 322b are provided with a plurality of first agglomeration stirring blades 324a and a second agglomeration stirring blade 324b"}, {"pat_id": "KR-100657177-B1", "para_id": "para_14", "text": "that is in the above described construction method since the water supply pipe is long connected in one direction the bearing capacity for the transverse pressure is extremely weak and even if a slight ground subsidence of the water supply pipe is easily bent or twisted the breakage and gap of the water supply pipe may be generated"}, {"pat_id": "JP-5738390-B2", "para_id": "para_32", "text": "in addition when applying to the activated sludge treatment method of the mbr method membrane separation method it is desirable to take appropriate measures so that the membrane breakage phenomenon due to the addition of powdered activated carbon does not occur in a short time"}]</data>
</edge>
