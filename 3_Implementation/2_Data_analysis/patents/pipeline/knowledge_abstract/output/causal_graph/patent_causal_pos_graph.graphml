<edge source="wind" target="breakage">
  <data key="d1">2</data>
  <data key="d2">to prevent</data>
  <data key="d3">["KR-200483342-Y1"]</data>
  <data key="d4">["to prevent"]</data>
  <data key="d5">["rainwater", "space", "building", "appearance", "house", "exposure", "time", "snow", "pattern", "water", "tank", "ceiling", "color", "portion", "breakage", "inside", "wind", "feeling", "reservoir", "slope", "decay", "rain", "harmony", "sunlight", "angle", "storage", "deformation", "compartment"]</data>
  <data key="d6">["cause", "use", "flow", "form", "build", "can", "do", "fall", "be", "cover", "have", "prevent", "spoil"]</data>
  <data key="d7">[{"pat_id": "KR-200483342-Y1", "para_id": "para_28", "text": "it has a cold feeling that is not in harmony with the appearance of a house or a building it is covered with the rainwater reservoir of the color pattern and built in the inside space to prevent direct exposure to direct sunlight rain and wind so that even if it is used for a long time it does not cause deformation or breakage of rainwater reservoir and can prevent water from being spoiled"}, {"pat_id": "KR-200483342-Y1", "para_id": "para_50", "text": "it is possible to prevent the direct exposure to direct sunlight rain and wind by preventing the rainwater storage tank of the uniform color pattern from being covered with the inside of the rainwater storage compartment or breakage of the water can be prevented and the decay of the water can be prevented and the ceiling portion is formed with a sloped slope at a constant angle so that the snow or rain can flow without falling"}]</data>
</edge>
