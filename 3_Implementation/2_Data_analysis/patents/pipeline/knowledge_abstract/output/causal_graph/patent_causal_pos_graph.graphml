  <data key="d7">[{"pat_id": "JP-5240962-B2", "para_id": "para_19", "text": "since there is cloth and paper under the clay board it will not break or break during movement or construction"}, {"pat_id": "US-5049312-A", "para_id": "para_19", "text": "detection of this leak prevented imminent rupture of an adjacent sour gas line affected by the leak"}, {"pat_id": "KR-102644212-B1", "para_id": "para_13", "text": "the method of repairing the joint of the manhole sewer pipe and drain pipe of the present invention to achieve the above object is to dig up the area around the manhole 10 where the water leak occurred and then remove the existing buried sewer pipe or the existing pipe used as the drain pipe"}, {"pat_id": "KR-102644212-B1", "para_id": "para_27", "text": "and after the curing and hardening of the mortar the area around the manhole is restored and cleaned up and finished s600 so that the water leak phenomenon occurring at the joint 70 of the manhole can be repaired and above all the sewage water leaking to the outside of the manhole because it is easy to block water and drains using clay rapid repair work is possible"}, {"pat_id": "US-5167867-A", "para_id": "para_23", "text": "detection of this leak prevented imminent rupture of an adjacent sour gas line affected by the leak"}]</data>
</edge>
