  <data key="d7">[{"pat_id": "US-10480824-B2", "para_id": "para_71", "text": "the elevation of the sensor channel 602 from the base 202 of the bottom pan 200 is provided to avoid triggering the leak sensor 1200 disposed in the sensor channel 602 when only a little water drips into the pan thereby avoiding false positive detections"}, {"pat_id": "US-10480824-B2", "para_id": "para_93", "text": "accordingly water that accumulates in the bottom pan may contact the leak sensor 1200 via the opening at the bottom portion 1195 of the sensor housing 1000 when the water level rises to the elevation at which the leak sensor 1200 is disposed in the sensor channel 1102"}, {"pat_id": "US-10480824-B2", "para_id": "para_114", "text": "that is the sensor channel 2402 in which the leak sensor is disposed may determine the elevation to which water accumulated in the bottom pan 200 must rise before the water contacts the leak sensor to trigger the leak sensor"}]</data>
