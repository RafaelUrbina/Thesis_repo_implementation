  <data key="d5">["course", "water", "purpose", "channel", "contaminant", "embodiment", "titanium", "system", "circulation", "removal", "effect", "photocatalyst", "dioxide"]</data>
  <data key="d6">["use", "include", "be", "observe", "may"]</data>
  <data key="d7">[{"pat_id": "JP-5349551-B2", "para_id": "para_9", "text": "of course it may be a water channel used for other purposes"}, {"pat_id": "KR-100584236-B1", "para_id": "para_27", "text": "this embodiment is for observing the contaminant removal effect of a water circulation system including a water channel using a titanium dioxide photocatalyst"}]</data>
</edge>
<edge source="water channel" target="gradient">
  <data key="d1">2</data>
  <data key="d2">due to</data>
  <data key="d3">["EP-0535375-B1"]</data>
  <data key="d4">["due to", "thus"]</data>
  <data key="d5">["dirty", "rainwater", "waste", "water", "flow", "channel", "form", "advantage", "discharge", "fact", "gradient", "system", "separation", "invention", "rain"]</data>
  <data key="d6">["transfer", "can", "be", "get", "accord", "provide", "take"]</data>
  <data key="d7">[{"pat_id": "EP-0535375-B1", "para_id": "para_8", "text": "according to one form of the invention it is provided that the incorrect discharges are transferred into the latter due to a flow gradient between the rainwater channel and the dirty water channel"}, {"pat_id": "EP-0535375-B1", "para_id": "para_8", "text": "this takes advantage of the fact that in a separation system the dirty water channel is always lower than the rain water channel and thus the dirty or waste water in the rain water channel can get into the dirty water channel due to the natural flow gradient"}]</data>
</edge>
<edge source="water channel" target="precipitation">
  <data key="d1">1</data>
  <data key="d2">while</data>
