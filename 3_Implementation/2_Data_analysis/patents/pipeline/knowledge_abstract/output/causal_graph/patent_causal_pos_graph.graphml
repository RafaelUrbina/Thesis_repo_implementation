  <data key="d7">[{"pat_id": "KR-100522326-B1", "para_id": "claim_1", "text": "limestone drain for sedimentation and removal of sludge contained in the runoff flowing out of the pit during mountainous highway construction a storage tank for storing the treated water discharged from the limestone drain but discharged when a predetermined amount is introduced in consideration of the case where a large amount of groundwater flows out due to rainy season or hydrogeological site conditions aquifer and a reaction tank for removing heavy metals contained in the acid drainage by mixing red mud powder with the discharge water discharged from the storage tank"}, {"pat_id": "KR-200340109-Y1", "para_id": "claim_7", "text": "limestone drain for sedimentation and removal of sludge contained in the runoff flowing out of the pit during mountainous highway construction a storage tank for storing the treated water discharged from the limestone drain but discharged when a predetermined amount is introduced in consideration of the case where a large amount of groundwater flows out due to rainy season or hydrogeological site conditions aquifer and a reaction tank that mixes red mud powder with effluent discharged from the storage tank and treats acidic drainage on the basis of drinking water quality standards"}, {"pat_id": "EP-1522525-B1", "para_id": "para_8", "text": "the pit used here consists of a settling pit which is connected via an inlet to a filter shaft"}, {"pat_id": "KR-101644963-B1", "para_id": "para_78", "text": "according to one embodiment the high concentration rainfall runoff that has passed through the first stage purification facility first water purification unit of the water quality purification unit g is transferred to the treated water feet 73 through the treated the polluted river water or low concentration rainwater having passed through the two stage facility second water quality purification unit is transferred to the natural water under the treated water pit 73 and discharged to the river or supplied as reused water or if there is a subsequent linkage facility it may be configured to be transported to that facility"}, {"pat_id": "US-7640792-B2", "para_id": "para_6", "text": "based on these measurements engineers can determine whether a proposed basin design is acceptable or otherwise determine alternative design parameters for a drainage basin"}]</data>
