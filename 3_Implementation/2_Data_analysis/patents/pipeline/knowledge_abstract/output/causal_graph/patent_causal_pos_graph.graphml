  <data key="d7">[{"pat_id": "KR-102316554-B1", "para_id": "para_8", "text": "however in the case of joining concrete hume pipes due to the nature of the structure in which the male and female hume pipes are joined together when an earthquake or ground deformation occurs stress is concentrated in the joint and local damage occurs"}, {"pat_id": "KR-102303480-B1", "para_id": "para_8", "text": "however in the case of joining concrete hume pipes due to the nature of the structure in which the male and female hume pipes are joined together when an earthquake or ground deformation occurs stress is concentrated in the joint and local damage occurs"}, {"pat_id": "KR-200443724-Y1", "para_id": "para_38", "text": "due to the nature of the plastic material in the process of joining it is possible to reduce the breakage rate of the filter housing joint compared to the built in female screw that is easy to damage the pipe wall and to temporarily fill the gap by using taping means such as teflon tape without watering in case of emergency such as water leakage"}]</data>
</edge>
