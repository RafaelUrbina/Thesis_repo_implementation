  <data key="d5">["lake", "stream", "space", "distribution", "infrastructure", "sedimentation", "layer", "step", "outflow", "precipitation", "device", "module", "plant", "water", "tank", "treatment", "influent", "matter", "sludge", "oxidation", "solid", "vegetation", "purification", "inflow", "channel", "material", "control", "contact", "microorganism", "energy", "flow", "discharge", "rate", "pipe", "storage", "wetland", "drainage"]</data>
  <data key="d6">["include", "purify", "plant", "undergo", "arrange", "form", "integrate", "introduce", "base", "distribute", "adsorb", "suspend", "filter", "pass", "have", "remove", "configure", "flow", "precipitate", "discharge", "be", "store", "decompose", "adjust", "settle", "instal"]</data>
  <data key="d7">[{"pat_id": "KR-100624556-B1", "para_id": "para_32", "text": "an inflow water distribution step of evenly distributing the energy of the stream water the lake water or the outflow water flowing into the integrated water purification device through the flow distribution tank to the modular wetland infrastructure a primary purification step in which the influent distributed to the modular wetland infrastructure is decomposed adsorbed and settled by the microorganisms of the wetland plants and wetlands planted in adjacent vegetation based modules a secondary purification step in which the inflow water is physically filtered while passing through the vegetation based module arranged adjacent to the modular wetland infrastructure a drainage storage step in which the inflow water passing through the modular wetland infrastructure flows into the sedimentation tank through the drainage layer installed while forming a predetermined space a precipitation step of precipitating unfiltered foreign matter while undergoing primary and secondary purification treatments included in the influent stored in the precipitation tank a third purification step in which the inflow water which has passed the precipitation step is biologically purified while being introduced and passed through the contact oxidation tank in which the microbial contact material is installed a fourth purification step of finally removing fine sludge and suspended solids not filtered in the contact oxidation tank through the filtering tank a flow rate adjusting step of adjusting a flow rate discharged into the water channel through the discharge pipe through the discharge control tank it is configured to include"}]</data>
</edge>
