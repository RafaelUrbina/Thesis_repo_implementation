  <data key="d7">[{"pat_id": "KR-102569861-B1", "para_id": "para_5", "text": "in particular as the waterworks ordinance was changed so that water service providers bear the cost of freezing and bursting from 2014 according to the decision of the anti corruption and civil rights commission the city of seoul has implemented a water meter system to prevent water meter freezing and bursting such as publicity and freezing prediction and citizen idea recruitment"}, {"pat_id": "KR-102569861-B1", "para_id": "para_56", "text": "this was also confirmed by the research results of study on measures to prevent water meters from freezing in seoul building city research information center 2007"}, {"pat_id": "KR-102569861-B1", "para_id": "para_68", "text": "this was also confirmed by the research results of study on measures to prevent water meters from freezing in seoul building city research information center 2007"}]</data>
