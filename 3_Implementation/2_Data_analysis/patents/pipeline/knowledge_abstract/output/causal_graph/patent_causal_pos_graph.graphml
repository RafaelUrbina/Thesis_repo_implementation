  <data key="d5">["granulometrie", "logic", "place", "bank", "lamp", "minute", "sedimentation", "valve", "pusher", "pit", "part", "site", "tank", "purpose", "reading", "swash", "float", "order", "level", "degradation", "solid", "settling", "photograph", "anchor", "tower", "camera", "screen", "direction", "recovery", "coupling", "angle", "communication", "monitoring", "presence", "aeration", "video", "pump", "displacement", "submersible", "disinfection", "current", "activation", "wastewater", "time", "lighting", "mg", "water", "digestion", "hypochlorite", "sludge", "process", "microbubble", "channel", "fig", "electro", "period", "day", "filtration", "plate", "microorganism", "operation", "respect", "mud", "description", "resolution", "access", "storage", "function", "information", "chloride", "bubble", "steel", "installation", "generation", "impeller", "substance", "controller", "system", "voltage", "pipeline", "aerator", "phase", "panel", "mount", "area", "treatment", "bottom", "carbon", "consumption", "matter", "mixture", "source", "result", "end", "state", "shredder", "frame", "chlorine", "separation", "platform", "night", "oxidative", "sodium", "sewage", "sand", "garnet", "discharge", "hose", "series", "recirculation", "temperature", "elimination", "passage", "power", "precipitation", "invention", "mean", "totality", "type", "package", "gravel", "supply", "bacteria", "use", "condition", "sensor", "capacity", "charge", "graph", "surrounding", "eductor", "air", "quality", "drawing", "battery", "material", "pathogen", "control", "connection", "oxygen", "silica", "facility", "unit", "energy", "liquid", "feeding", "reactor", "efficiency", "flotation"]</data>
