  <data key="d7">[{"pat_id": "KR-101627772-B1", "para_id": "para_7", "text": "if the corroded sewer pipe is buried in the ground the strength is easily weakened due to shrinkage and expansion due to the thermal expansion coefficient after being buried and a breakage phenomenon appears at the connection portion between the profile and the joint member"}, {"pat_id": "KR-101618778-B1", "para_id": "para_7", "text": "if the corroded sewer pipe is buried in the ground the strength is easily weakened due to shrinkage and expansion due to the thermal expansion coefficient after being buried and a breakage phenomenon appears at the connection portion between the profile and the joint member"}]</data>
</edge>
<edge source="thermal expansion" target="freezing">
