  <data key="d7">[{"pat_id": "JP-7363875-B2", "para_id": "para_78", "text": "further the place where the chemical is added is not particularly limited and may be any place in the cooling water system for example a blowing means a watering means a pit a make up water supply means a chemical injection means a circulation waterway a transfer pump a heat exchanger etc"}, {"pat_id": "JP-7363875-B2", "para_id": "para_80", "text": "in the open circulation cooling water system 1 water containing the component a copolymer and the component b maleic acid polymer is transferred from the pit 15 to the heat exchanger 30 via the circulation waterway 20 by the transfer pump 21"}, {"pat_id": "JP-7456522-B1", "para_id": "para_111", "text": "further the place where the chemical is added is not particularly limited and may be any place in the cooling water system such as a water sprinkling means a pit a make up water supply means a chemical injection means a circulation waterway a transfer pump a heat exchanger etc"}, {"pat_id": "JP-7456522-B1", "para_id": "para_114", "text": "then it returns to the open cooling tower 10 via the circulation waterway 20"}]</data>
</edge>
