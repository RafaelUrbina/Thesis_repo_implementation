  <data key="d1">2</data>
  <data key="d2">shape</data>
  <data key="d3">["US-9580899-B2", "KR-101715378-B1"]</data>
  <data key="d4">["shape"]</data>
  <data key="d5">["corruption", "through", "nut", "position", "flange", "part", "concept", "stand", "bar", "contact", "jaw", "odor", "rain", "coupling", "flow", "exception", "pipe", "object", "round", "blockage", "burden", "roadside", "cylinder", "distance", "grid", "water", "plurality", "environment", "leveler", "contour", "member", "portion", "correspondence", "mesh", "structure", "cap", "stone", "barrier", "lid", "hole", "steel", "securement", "installation", "generation", "system", "support", "screwdriver", "surface", "insertion", "treatment", "receiving", "matter", "storm", "end", "state", "barrel", "aspect", "wall", "road", "frame", "box", "roadway", "lattice", "head", "engagement", "sewage", "sewer", "conduit", "drainage", "edge", "opening", "invention", "block", "plant", "side", "port", "june", "network", "resistance", "material", "sewerage", "bolt", "boundary", "mantle", "unit", "shape", "liquid", "groove", "body", "technique"]</data>
  <data key="d6">["receive", "guide", "bend", "provide", "weld", "open", "block", "prevent", "mean", "penetrate", "connect", "correspond", "form", "float", "eliminate", "contour", "transport", "close", "insert", "intend", "seat", "bolt", "secure", "filter", "remove", "cover", "extend", "have", "minimize", "reduce", "register", "couple", "reinforce", "may", "fix", "shape", "flow", "do", "be", "hang", "span", "instal", "comprise"]</data>
  <data key="d7">[{"pat_id": "KR-101715378-B1", "para_id": "para_12", "text": "10 1636033 registered on june 26 2016 environment friendly water and sewerage system for removing foreign material accordingly it is an object of the present invention to minimize the flow resistance of sewage water by eliminating the foreign matter in the sewage flowing through the sewer pipe to prevent foreign matter from being transported to the sewage treatment plant thereby reducing the burden on the sewage treatment plant it is also intended to provide a sewerage conduit structure having a foreign matter filter net structure that minimizes the generation of odor due to the corruption of foreign matter.according to an aspect of the present invention there is provided a sewage pipe system comprising a sewer pipe an excellent receiving portion provided at a predetermined distance from a drainage port provided between the boundary and the roadway between the roadway and the roadway and connected to the drainage pipe a foreign matter blocking unit installed on an upstream side of the excellent receiving unit to block floating foreign matter from flowing to the excellent receiving unit along with the rain flowing through the road surface and an excellent guiding boundary provided between the roadway and the drainage side to guide the roadside storm and foreign matter to the side of the foreign matter blocking part without flowing directly into the excellent receiving part and an upper end opened and having a flange portion at a top edge and a vertical portion bent upward from an edge of the flange portion a lower flange portion that is inserted into the superior receiving body and opens at upper and lower ends thereof and is seated on the flange portion at an upper edge thereof a vertical portion bent upward from an edge of the lower flange portion a reinforcing cylinder having an upper flange portion that spans an upper end of a vertical portion of the superior receiving body a screwdriver coupled to the lower end opening of the reinforcing cylinder a grid like leveler cap covering the top opening of the reinforcing cylinder a cap engagement means for coupling the cap to the cap receiving stand and a connecting pipe connecting the excellent receiving body and the sewage pipe wherein the superior receiving body is inserted into a well receiving hole formed in the drainage port and the flange portion and the vertical portion are formed on the edge of the superior receiving hole and the mesh network is formed by bending inwardly at the lower end opening edge of the reinforcing barrel and the mesh network is formed in a state where the barrel mesh network is extended over the formed hanging jaws a bolt penetrating hole formed at a central portion of the mantle a nut welded and fixed to a lower surface of a central portion of the mantle and coaxial with the bolt penetrating hole a bolt penetrating hole formed at a central portion of the stainless steel cover a bolt head insertion groove formed in an upper end of the through hole a lower end portion of the bolt head insertion groove being in close contact with an upper surface of a central portion of the mantle and a coupling bolt penetrating through the bolt through hole the round bar and the bolt through hole to be coupled to the nut and having a head inserted into the bolt head insertion groove wherein the foreign a box shaped support frame whose lower end is closed and whose upper end is open and a foreign matter blocking lid formed in a lattice shape so as to be inserted into the support frame and the support frame of the foreign matter blocking portion is inserted and seated in the foreign matter blocking portion installation groove formed in the drainage port and a barrier block for blocking foreign matter the barrier block being provided at a position corresponding to the excellent receiving portion and provided with a plurality of through holes provided at a position without the excellent receiving portion wherein the boundary stones are formed so that the boundary stones installed in correspondence with the excellent receiving portions are formed higher than the other boundary stones so that the excellent flows flowing along with the foreign matters do not flow directly into the excellent receiving portions"}, {"pat_id": "US-9580899-B2", "para_id": "para_70", "text": "end walls 82 may be fixedly secured to respective flange members 18 through bolting threaded securement or some like technique not important to the inventive concept with the exception that such end walls 82 may be contoured in a similar elliptical shape as the flange members 18 or otherwise contoured in any contour to provide the liquid blockage necessary"}]</data>
</edge>
