  <data key="d7">[{"pat_id": "JP-6254972-B2", "para_id": "para_8", "text": "a method of listening to a water leak sound acoustic vibration transmitted from a water leak point with a sound stick or contacting a correlated water leak detector on a transparent plate covering the display surface 34b of the display unit 34a of the water meter 34 in the case of methods such as detecting water leakage sound transmitted from the location of water leakage both methods are affected by ambient noise and unnecessary vibrations wind effects and camera shake etc"}, {"pat_id": "US-12305815-B2", "para_id": "para_29", "text": "for example the transport non return valve ensures that a higher pressure in the main line does not cause the fluid to flow back into the wind turbine which may provide the fluid at a lower pressure or in case of a leak the fluid would be prevented flowing back to the leak"}, {"pat_id": "US-10948132-B2", "para_id": "para_53", "text": "a hydrophone may offer significant advantages over a piezoelectric element which when mounted to a structure like a fire hydrant will sense incidental acceleration from leak sound waves traveling through the water in the pipe"}, {"pat_id": "US-6834556-B2", "para_id": "para_59", "text": "for example base sensors may include chemical detectors and weather sensors that indicate the air temperature wind speed wind direction precipitation sunlight levels humidity barometric pressure or other environmental properties"}]</data>
