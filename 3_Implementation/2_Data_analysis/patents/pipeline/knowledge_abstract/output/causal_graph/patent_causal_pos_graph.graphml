  <data key="d6">["turbine", "warm", "make", "combine", "valve", "drill", "weld", "rise", "sink", "connect", "trap", "float", "indicate", "sld", "remain", "dump", "refer", "leave", "secure", "anchor", "minimize", "have", "wear", "compile", "discard", "reinforce", "fix", "flow", "reset", "go", "can", "trim", "revolve", "pump", "provide", "wrap", "chamfer", "lift", "handle", "grab", "cast", "hold", "uncoil", "ship", "bend", "set", "prevent", "attach", "scale", "load", "rope", "form", "measure", "divide", "plow", "crush", "mark", "size", "seal", "save", "spray", "vibrate", "switch", "limit", "occur", "wind", "couple", "follow", "decay", "check", "mix", "push", "oil", "do", "protect", "snap", "settle", "bubble", "pack", "sonar", "alternate", "stick", "flash", "join", "regulate", "surface", "ld", "baffle", "tow", "hoist", "integrate", "coat", "point", "clean", "weave", "lead", "spawn", "box", "cover", "reduce", "plug", "may", "head", "warn", "designate", "corrode", "cool", "bush", "start", "fit", "net", "drive", "spot", "change", "separate", "guide", "incline", "act", "include", "operate", "block", "expand", "blow", "supply", "use", "propeller", "stop", "charge", "cut", "asphyxiate", "straighten", "throttle", "finish", "draw", "rotate", "classify", "galvanize", "maintain", "case", "monitor", "input", "be", "age", "rack", "generate", "collect", "suppress", "bleed", "wet"]</data>
  <data key="d7">[{"pat_id": "KR-101179577-B1", "para_id": "para_76", "text": "a margin can be provided and the amount of rainwater remaining in the waterway can be minimized so that water pooling does not occur and the remaining rainwater can be decayed or reduce the occurrence of odor and block the reproduction of pests"}, {"pat_id": "KR-102733651-B1", "para_id": "para_303", "text": "12 the material of the valve of the conventional underground passage flood prevention and water damage control equipment is made harder than the material of the valve seat to prevent wear and at the same time the expansion valve 489 is formed by separating and dividing into a diaphragm type expansion valve 490 and a bellows type expansion valve 491"}, {"pat_id": "KR-102733651-B1", "para_id": "para_403", "text": "13 the main problem during the operation of the pump of the conventional underground passage flood prevention and water damage control equipment is that if the temperature rises due to the heat of the liquid being handled or the frictional heat of the wetted surface the material may wear out or corrode or the packing may stick so in order to suppress this the following basic methods are used to have cooling and lubrication functions"}, {"pat_id": "KR-102733651-B1", "para_id": "para_963", "text": "the following outrigger maintains safety and prevents the tire from being loaded thereby preventing wear and damage due to the load of tires and springs"}, {"pat_id": "KR-102733651-B1", "para_id": "para_1169", "text": "main switch button for off control 67 auxiliary switch button 68 input of display for vertical multistage pump or computer network input 69 current pressure value or set pressure value pressure setting value recognition nameplate 70 memory 71 power cable 73 disaster prevention material mixer 74 turbine water turbine 75 cloth cover 76 solenoid valve 77 ad balloon 78 airship 79 gas cylinder 80 air compressor 81 mobile service 82 portable terminal 83 low pressure cutoff va