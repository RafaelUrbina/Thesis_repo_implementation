  <data key="d7">[{"pat_id": "KR-100810555-B1", "para_id": "para_1", "text": "in general, underground pipelines, such as concrete pipes, pvc pipes, and conduits, have defects such as cracking, breakage, or separation of connections due to ageing of the pipe itself, subsidence of the underground ground, or variations in earth pressure from the ground"}, {"pat_id": "KR-102014763-B1", "para_id": "para_1", "text": "here, structural defects in sewage conduits mean defects such as cracking, breakage, or disconnection due to aging of the pipe itself, subsidence of underground ground or fluctuations in earth pressure from the ground"}, {"pat_id": "KR-200344163-Y1", "para_id": "para_1", "text": "that is, in the above-described construction method, since the water supply and drainage pipes are long connected in one direction, the bearing capacity for the transverse pressure is extremely weak, and even a slight ground subsidence of the water supply and drainage pipe buried site may easily cause the breakage and gaps of the water supply and drainage pipe to be bent or twisted"}, {"pat_id": "KR-200344163-Y1", "para_id": "para_1", "text": "that is, in the above-described construction method, since the water supply and drainage pipes are long connected in one direction, the bearing capacity for the transverse pressure is extremely weak, and even a slight ground subsidence of the water supply and drainage pipe buried site may easily cause the breakage and gaps of the water supply and drainage pipe to be bent or twisted"}, {"pat_id": "KR-200344164-Y1", "para_id": "para_1", "text": "that is, in the above-described construction method, since the water supply and drainage pipes are long connected in one direction, the bearing capacity for the transverse pressure is extremely weak, and even a slight ground subsidence of the water supply and drainage pipe buried site may easily cause the breakage and gaps of the water supply and drainage pipe to be bent or twisted"}, {"pat_id": "KR-200344166-Y1", "para_id": "para_1", "text": "that is, in the above-described construction method, since the water supply and drainage pipes are long connected in one direction, the bearing capacity for the transverse pressure is extremely weak, and even a slight ground subsidence of the water supply and drainage pipe buried site may easily cause the breakage and gaps of the water supply and drainage pipe to be bent or twisted"}, {"pat_id": "KR-100730651-B1", "para_id": "para_1", "text": "in general, underground pipelines cause cracks, breakage, or stepped joints due to aging of the pipeline itself, subsidence of the underground ground or fluctuations in earth pressure from the ground, and the wastewater inside the pipeline flows out through the broken portion"}, {"pat_id": "KR-100810555-B1", "para_id": "para_1", "text": "in general, underground pipelines, such as concrete pipes, pvc pipes, and conduits, have defects such as cracking, breakage, or separation of connections due to ageing of the pipe itself, subsidence of the underground ground, or variations in earth pressure from the ground"}, {"pat_id": "KR-102063829-B1", "para_id": "para_1", "text": "in general, underground pipelines such as sewer pipes buried underground cause sagging and breakage due to aging of the pipe itself, subsidence of the underground bed, or fluctuations in earth pressure from the ground"}]</data>
