  <data key="d5">["growth", "plant", "network", "information", "leakage", "vegetation", "tree", "motion", "intrusion", "pipeline", "increase", "cause", "methane", "vicinity", "terrain", "content", "leak", "satellite", "water", "area", "vhr", "imagery", "damage", "root"]</data>
  <data key="d6">["cause", "contain", "compare", "lead", "impact", "relate", "be", "outline", "increase", "detect"]</data>
  <data key="d7">[{"pat_id": "US-6243483-B1", "para_id": "para_1", "text": "the infrared information contained within vhr satellite imagery is potentially useful for detecting methane related vegetation damage, which can be caused by pipeline leakage"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "increase in water content in the vicinity of a water network leak may lead to an increase in vegetation growth in that area compared to other nearby areas"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "one of the principal causes of water network leakage is vegetation intrusion, where roots from plants or trees physically impact on the water network, causing damage and ultimately a leak"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "as outlined above, vegetation intrusion and terrain motion are the main environmental causes of water network leakage"}]</data>
</edge>
