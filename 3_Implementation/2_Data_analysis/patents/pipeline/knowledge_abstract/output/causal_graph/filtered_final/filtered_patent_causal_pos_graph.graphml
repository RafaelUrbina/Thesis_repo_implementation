  <data key="d5">["conduit", "fluctuation", "defect", "variation", "drainage", "bearing", "sagging", "gap", "crack", "site", "pressure", "capacity", "pvc", "sewage", "pipeline", "pipe", "wastewater", "separation", "supply", "joint", "cause", "bed", "subsidence", "construction", "ground", "cracking", "aging", "breakage", "method", "water", "direction", "earth", "portion", "disconnection", "ageing", "sewer", "connection"]</data>
