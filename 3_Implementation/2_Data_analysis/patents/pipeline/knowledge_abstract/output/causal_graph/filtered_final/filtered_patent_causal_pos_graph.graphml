  <data key="d6">["float", "know", "contain", "deposit", "prevent", "use", "decrease", "increase", "discharge", "form", "maintain", "be"]</data>
  <data key="d7">[{"pat_id": "US-8741100-B2", "para_id": "para_1", "text": "where feed streams contain certain compounds such as carbonates for which solubility decreases with increasing temperature, deposits, generally known as boiler scale, will form even at relatively low concentrations due to the elevated temperatures at the surfaces of the heat exchangers"}, {"pat_id": "KR-200365446-Y1", "para_id": "para_1", "text": "by using the control equipment, the water level difference between the upper and the downstream filtration tanks is maintained at 1.0-1.5m, so that the sediment deposited in the upper and the downstream filtration tanks can be gradually discharged during the initial flooding with less floating dust, thereby preventing the ultimate closure of the filter media"}]</data>
