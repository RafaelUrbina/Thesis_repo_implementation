  <data key="d2">increase</data>
  <data key="d3">["EP-3655743-B1"]</data>
  <data key="d4">["cause", "contribute to", "increase"]</data>
  <data key="d5">["cause", "location", "water", "leak", "factor", "leakage", "tree", "soil", "vicinity", "network", "content", "terrain", "attribute", "intrusion", "increase", "plant", "damage", "motion", "root", "type", "combination", "area", "growth", "vegetation"]</data>
  <data key="d6">["cause", "contribute", "lead", "impact", "increase", "compare", "outline", "be"]</data>
  <data key="d7">[{"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "increase in water content in the vicinity of a water network leak may lead to an increase in vegetation growth in that area compared to other nearby areas"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "one of the principal causes of water network leakage is vegetation intrusion, where roots from plants or trees physically impact on the water network, causing damage and ultimately a leak"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "as outlined above, vegetation intrusion and terrain motion are the main environmental causes of water network leakage"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "the combination of the physical attributes of the soil and the physical attributes for the type of the classified vegetation at each location, are all factors that may contribute to vegetation intrusion that can cause a water network leak"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "one of the principal causes of water network leakage is vegetation intrusion, where roots from plants or trees physically impact on the water network, causing damage and ultimately a leak"}, {"pat_id": "EP-3655743-B1", "para_id": "para_3", "text": "as outlined above, vegetation intrusion and terrain motion are the main environmental causes of water network leakage"}]</data>
</edge>
