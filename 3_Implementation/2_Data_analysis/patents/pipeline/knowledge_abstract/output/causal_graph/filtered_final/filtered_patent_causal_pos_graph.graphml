  <data key="d5">["temperature", "configuration", "gauge", "burst", "heating", "system", "freeze", "device", "air", "reading", "pressure", "advance", "example", "wire", "pipeline", "point", "pipe", "prevent", "prevention", "insulation", "season", "embodiment", "usage", "type", "accordance", "water", "winter", "indoor", "meter", "drain", "sensor", "freezing", "bursting", "portion", "invention", "drop"]</data>
  <data key="d6">["have", "inspect", "burst", "operate", "freeze", "discharge", "allow", "take", "connect", "use", "cause", "prevent", "supply", "accommodate", "accompany", "relate", "describe", "check", "be", "install", "instal"]</data>
  <data key="d7">[{"pat_id": "KR-200302627-Y1", "para_id": "para_1", "text": "an anti-freezing-burst type water meter the present invention relates to a water meter, and more particularly to a freeze-proof water meter having a drain portion for discharging water in accordance with the temperature drop in the lower portion of the water meter to prevent freezing caused by the temperature drop in the winter season"}, {"pat_id": "KR-200301700-Y1", "para_id": "para_1", "text": "freeze prevention device of water meter frozen to burst prevent of water gauge the present invention relates to a device for preventing the freezing of the water meter, in particular to install a heating wire in the lower portion of the water meter and to operate when the outside temperature is below the freezing point to prevent the freeze of the water meter in advance"}, {"pat_id": "US-8117998-B2", "para_id": "para_1", "text": "it is possible to prevent pipelines from freezing and bursting at temperatures below zero during the winter, using the configuration of the hot water supplying system 20"}, {"pat_id": "US-11066813-B2", "para_id": "para_1", "text": "in some example embodiments, the temperature sensor (115) may be used to prevent pipes from freezing, and the pressure sensor (115) may be used to prevent pipes from bursting"}, {"pat_id": "US-11066813-B2", "para_id": "para_1", "text": "in some example embodiments, the temperature sensor (115) may be used to prevent pipes from freezing, and the pressure sensor (115) may be used to prevent pipes from bursting"}, {"pat_id": "KR-102466363-B1", "para_id": "para_1", "text": "since the outside air temperature drops below freezing in winter, proper insulation must be accompanied to prevent freezing and bursting of the water meter and the water pipe connected to the water meter, and an open configuration must be taken to allow meter reading of usage even in winter"}, {"pat_id": "KR-102683498-B1", "para_id": "para_4", "text": "however, since water meters as described above must be checked or inspected frequently, they are generally installed outdoors rather than indoors, so it is not uncommon for them to easily freeze and burst due to low temperatures in the winter"}, {"pat_id": "KR-200301700-Y1", "para_id": "para_1", "text": "freeze prevention device of water meter frozen to burst prevent of water gauge the present invention relates to a device for preventing the freezing of the water meter, in particular to install a heating wire in the lower portion of the water meter and to operate when the outside temperature is below the freezing point to prevent the freeze of the water meter in advance"}, {"pat_id": "KR-200302626-Y1", "para_id": "para_1", "text": "an anti-freezing-burst type water meter the present invention relates to a water meter, and more particularly, to a freeze-proof water meter to accommodate the air into the water meter to prevent freezing caused by a sudden drop in temperature in winter"}, {"pat_id": "KR-200302627-Y1", "para_id": "para_1", "text": "an anti-freezing-burst type water meter the present invention relates to a water meter, and more particularly to a freeze-proof water meter having a drain portion for discharging water in accordance with the temperature drop in the lower portion of the water meter to prevent freezing caused by the temperature drop in the winter season"}]</data>
</edge>
