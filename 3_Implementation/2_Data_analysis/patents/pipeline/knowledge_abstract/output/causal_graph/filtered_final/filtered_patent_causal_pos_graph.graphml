  <data key="d7">[{"pat_id": "KR-101059570-B1", "para_id": "para_2", "text": "when a large amount of water flows into the alkali supply tank 10 due to heavy rain or the like, a warning signal is generated when water at a preset level warning level is set at the external terminal to the level before the mine drainage is overflowed and the alkali is confirmed by checking the alkali"}, {"pat_id": "US-4709723-A", "para_id": "para_1", "text": "during heavy rains, ground water leakage into the prior art septic tanks and sewage systems can increase the flow rate to the central sewage processing facility by a factor of 10 or more"}, {"pat_id": "KR-101875497-B1", "para_id": "para_1", "text": "that is, when the sea water purification facility 120 can not process all of the contaminated water even though the internal water level of the shielding facility 110 is higher than a predetermined reference value due to a large difference between heavy rain, heavy rain or tide water, and transports the polluted water to the land-based storage tank 140 through the first pipeline 150"}]</data>
</edge>
<edge source="tank" target="hydraulic pressure">
  <data key="d1">5</data>
  <data key="d2">feed into</data>
  <data key="d3">["KR-100598365-B1", "US-4164854-A", "US-4709723-A"]</data>
  <data key="d4">["produce", "due to", "feed into", "increase"]</data>
  <data key="d5">["surface", "tendency", "water", "force", "gap", "level", "feed", "soil", "entry", "exchange", "wall", "portion", "subsidence", "fluid", "junction", "block", "interior", "heat", "column", "ground", "case", "ice", "period", "differential", "tank", "salt", "one", "pressure", "area", "leakage", "top"]</data>
  <data key="d6">["produce", "say", "melt", "become", "act", "divide", "leak", "compensate", "increase", "enable", "be", "move", "surround", "saturate", "collapse", "flow", "withdraw", "seal"]</data>
  <data key="d7">[{"pat_id": "US-4164854-A", "para_id": "claim_1", "text": "moving said block of ice upwardly in said tank by hydraulic pressure of incoming salt water and melting the upper portion of said block of ice by indirect heat exchange with the salt water feed prior to entry of said feed into said column and withdrawing pure water from the upper portion of the tank between the top of said tank and the top of said ice block"}, {"pat_id": "US-4164854-A", "para_id": "para_1", "text": "the hydraulic pressure acting upon the lower surface area of the ice block produces an upward force which becomes highest at the junction of the tank wall"}, {"pat_id": "US-4709723-A", "para_id": "para_1", "text": "sealing the tank against ground water increases the tendency for in-ground tanks to collapse under the increased hydraulic pressure differential between high ground water and the tank interior"}, {"pat_id": "KR-100598365-B1", "para_id": "para_1", "text": "this is because large water tanks, which are largely divided from large ones, are more likely to leak due to hydraulic pressure in the case of minor gaps and ground subsidence"}, {"pat_id": "US-4709723-A", "para_id": "para_1", "text": "during periods of high ground water levels, this leakage enabled additional fluid to flow into the tank to compensate for the increased hydraulic pressure of surrounding ground water and water saturated soil"}]</data>
</edge>
