  <data key="d5">["surface", "edge", "road", "water", "slope", "problem", "owner", "village", "energy", "reserve", "mountain", "dust", "fire", "absorption", "conflict", "groundwater", "supply", "tank", "source", "invention", "carbon", "effect", "forest", "addition", "area", "obstacle"]</data>
  <data key="d6">["cause", "provide", "operate", "fight", "instal", "build", "eliminate", "need", "block", "be"]</data>
  <data key="d7">[{"pat_id": "KR-102851468-B1", "para_id": "para_1", "text": "therefore, this invention provides a forest for carbon absorption built on a long slope at the edge of a road, which can be operated as a renewable energy source for water reserves, such as for blocking fine dust or for providing a water tank for fighting fires in mountainous areas, as needed"}, {"pat_id": "KR-100991695-B1", "para_id": "para_1", "text": "in addition, even if the intake tank is installed on the flat surface of the village does not cause any obstacle to the supply of groundwater provides an effect that eliminates all problems and conflicts with the owner of the intake tank must be installed in a high mountain"}]</data>
