  <data key="d4">["produce", "cause", "determine", "thus", "therefore"]</data>
  <data key="d5">["cloud", "basin", "detection", "catch", "unit", "impact", "tank", "water", "claim", "analysis", "area", "analyzer", "noise", "embodiment", "substance", "transfer", "vibration", "pipeline", "building", "downstream", "level", "range", "shut", "leakage", "action", "plumbing", "background", "outlet", "movement", "side", "surface", "case", "main", "stream", "datum", "sensor", "leak", "location", "change", "meter", "point", "valve", "fixture", "system", "process"]</data>
  <data key="d6">["direct", "produce", "generate", "take", "relate", "simulate", "base", "control", "use", "filter", "cause", "prevent", "determine", "assure", "enter", "exist", "configure", "look", "detect", "recognize", "mimic", "activate", "be", "leak"]</data>
  <data key="d7">[{"pat_id": "US-10410501-B2", "para_id": "para_6", "text": "the water meter and leak detection system 10, 126, 200 is configured to determine, based on an analysis of the stream of data points, whether a leak exists in at least one of the water fixtures"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "specific embodiments relate to directing a fluid stream through an outlet at an outer surface of the pipeline to cause a vibration in the pipeline which simulates a leak in the pipeline"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "the impact of the fluid stream on the outer surface of the pipeline 4 causes a vibration in the pipeline which mimics the vibration caused by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "in any case, the vibration caused by the fluid stream mimics the vibration caused by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "therefore, the thermal change in the pipeline 4 generated by directing a fluid stream onto the pipeline 4 can be used to simulate the thermal change caused by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "in an embodiment, therefore, the system 2 can be used to selectively direct a fluid stream at the outer surface of the pipeline 4 to cause a vibration and/or a thermal change in the pipeline 4 which mimics the vibration and/or the thermal change produced by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "therefore, the vibration caused by the fluid stream may more accurately mimic the vibration caused by the substance leaking from the pipeline"}, {"pat_id": "US-11095960-B2", "para_id": "para_4", "text": "the water meter and leak detection system is configured to determine, based on an analysis of the stream of data points, whether a leak exists in at least one of the water fixtures"}, {"pat_id": "US-11905688-B2", "para_id": "para_3", "text": "by recognizing a leak from multiple locations of the plumbing system 116, it can be determined if the leak is inside the building 112 or upstream from the building 112 looking back into the water main"}, {"pat_id": "US-11905688-B2", "para_id": "para_3", "text": "when detecting upstream leaks, the cloud analyzer 108 can activate a shut off valve for the plumbing system 116 to determine if the leak is within the plumbing system 116 or outside the building 112 or unit"}, {"pat_id": "US-11905688-B2", "para_id": "para_4", "text": "9c, background noise is filtered from the sensor signal(s) to determine building movement, detect upstream leaks and possibly take remedial action in the depicted process 900-3"}, {"pat_id": "US-5919002-A", "para_id": "para_1", "text": "the transfer of the water entering at the upstream catch basin to the one downstream with little or no leakage is thus assured"}, {"pat_id": "US-6627073-B2", "para_id": "para_1", "text": "if the water level in the area on the uppermost stream side in the electrolytic tank is controlled in a predetermined range, as in the claim 16, therefore, it is possible to more reliably prevent the water from leaking from the electrolytic tank"}]</data>
</edge>
