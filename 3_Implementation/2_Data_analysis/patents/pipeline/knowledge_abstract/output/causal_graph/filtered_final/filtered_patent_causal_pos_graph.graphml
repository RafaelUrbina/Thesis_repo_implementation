  <data key="d7">[{"pat_id": "US-11679993-B2", "para_id": "para_1", "text": "due to the occurrence of biofouling, which is expected in a typical treated wastewater stream and associated wastewater handling equipment, it is beneficial for the tss sensor 5a to include a wiper system (not shown per se) which periodically cleans the face of the sensor component (not shown per se) of the tss sensor 5a"}, {"pat_id": "US-8097212-B2", "para_id": "para_1", "text": "the simplest way to prevent biofouling of the platinum redox sensor is to locate it in a strongly flowing part of the water stream in the pipe, e.g., away from the walls"}]</data>
