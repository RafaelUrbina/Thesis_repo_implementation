  <data key="d5">["range", "water", "exchanger", "freezing", "problem", "deck", "conditioning", "kind", "air", "pipe", "heat", "battery", "rupture", "temperature", "pavement", "bridge", "installation", "equipment", "addition", "radiator", "winter", "layer", "valve"]</data>
  <data key="d6">["cause", "freeze", "drop", "occur", "have", "drain", "seep", "permeate", "remain", "be"]</data>
  <data key="d7">[{"pat_id": "KR-200498205-Y1", "para_id": "para_1", "text": "in addition, in the winter, if the permeated water that seeps into the pavement layer of the bridge deck is not drained quickly and remains, it freezes due to the low temperature, causing freezing and rupture of the pavement layer"}, {"pat_id": "EP-0354914-B1", "para_id": "para_1", "text": "installations of water-air heat exchangers of different kinds, heat batteries in air conditioning equipment, ordinary water radiators etc often have problems with pipe ruptures due to freezing in low air temperatures"}, {"pat_id": "KR-102440380-B1", "para_id": "para_1", "text": "this is because when the temperature drops to sub-zero range in winter, rupture due to freezing in valves or pipes may occur"}]</data>
</edge>
