  <data key="d7">[{"pat_id": "US-10329171-B2", "para_id": "para_1", "text": "additionally, this process may continue for as many treatment blocks 260 as there are in the treatment system 200, until a final permeate stream, optionally having untreated filtered seawater water blended therein, is produced from a final membrane pressure vessel"}, {"pat_id": "US-10329171-B2", "para_id": "para_1", "text": "4a-b, the filtered seawater may be provided to a treatment block 260 and either sent through blend/bypass line 225 or pumped by variable speed high-pressure pump 212, which pushes the filtered seawater through to one or more membrane pressure vessels (e.g., 214, 216, and 218), thereby creating a permeate stream and a concentrate stream"}, {"pat_id": "US-10343118-B2", "para_id": "para_1", "text": "additionally, this process may continue for as many treatment blocks 260 as there are in the treatment system 200, until a final permeate stream, optionally having untreated filtered seawater water blended therein, is produced from a final membrane pressure vessel"}, {"pat_id": "US-10343118-B2", "para_id": "para_1", "text": "4a-b, the filtered seawater may be provided to a treatment block 260 and either sent through blend/bypass line 225 or pumped by variable speed high-pressure pump 212, which pushes the filtered seawater through to one or more membrane pressure vessels (e.g., 214, 216, and 218), thereby creating a permeate stream and a concentrate stream"}, {"pat_id": "US-11780746-B2", "para_id": "para_23", "text": "in step (a) the removal of pfas is undertaken by actively aerating the contaminated waste comprising pfas in a first vessel (110) to produce a waste stream (112) comprising a concentration of pfas and a first liquid stream (114) having at least some of the first group of contaminants"}, {"pat_id": "US-5871648-A", "para_id": "para_9", "text": "chemical coagulants which react with contaminants in the wastewater feed stream 18 are introduced into the pretreatment reactor vessels via (produce) chemical coagulant feed streams 20, 22, and 24"}, {"pat_id": "US-5871648-A", "para_id": "para_9", "text": "the vessel drain opens to remove all contaminant via (produce) the sludge discharge stream 50"}, {"pat_id": "US-5965027-A", "para_id": "para_9", "text": "chemical coagulants which react with contaminants in the wastewater feed stream 18 are introduced into the pretreatment reactor vessels via (produce) chemical coagulant feed streams 20, 22, and 24"}, {"pat_id": "US-5965027-A", "para_id": "para_9", "text": "the vessel drain opens to remove all contaminant via (produce) the sludge discharge stream 50"}, {"pat_id": "US-6428705-B1", "para_id": "para_1", "text": "chemical coagulants, oxidizing agents, and/or reducing agents, which react with contaminants in the wastewater feed stream 18, are introduced into the pretreatment reactor vessels via (produce) chemical feed streams 20, 22, 24, and 26"}, {"pat_id": "EP-0513186-B1", "para_id": "para_3", "text": "while supercritical water oxidation requires a thicker walled vessel due to higher operating pressure, the less dense process stream in supercritical temperature water oxidation necessitates a larger vessel to achieve a comparable residence time"}, {"pat_id": "US-5106513-A", "para_id": "para_1", "text": "while supercritical water oxidation requires a thicker walled vessel due to higher operating pressure, the less dense process stream in supercritical temperature water oxidation necessitates a larger vessel to achieve a comparable residence time"}, {"pat_id": "US-5232604-A", "para_id": "para_1", "text": "while supercritical water oxidation requires a thicker walled vessel due to high operating pressure, the less dense process stream in semicritical water oxidation necessitates a larger vessel to achieve a comparable residence time"}]</data>
</edge>
