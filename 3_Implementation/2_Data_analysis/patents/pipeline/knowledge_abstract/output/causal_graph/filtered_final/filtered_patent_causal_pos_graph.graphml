  <data key="d7">[{"pat_id": "US-10246349-B2", "para_id": "para_3", "text": "powerful acoustic pressure shock waves 10 can break the ice and detach any possible ice formation from the cooling surfaces of the tanks/chambers/enclosures where the freezing process takes place, which reduces the risk of tanks/chambers/enclosures ruptures when acoustic pressure shock waves 10 are employed into the freeze process"}]</data>
</edge>
