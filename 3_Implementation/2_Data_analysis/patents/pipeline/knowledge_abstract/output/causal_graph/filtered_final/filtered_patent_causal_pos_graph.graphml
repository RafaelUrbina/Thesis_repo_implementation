  <data key="d7">[{"pat_id": "US-8661819-B2", "para_id": "para_1", "text": "the contaminants may be removed from the heat exchanger in a generally non-invasive manner by periodically discharging water with the highly concentrated contaminants from a bottom drain of the heat exchanger (e.g., blow-down, blow-by, etc.) and directing the water to a containment location (e.g., evaporation pond or heat exchanger, storage tank etc.)"}, {"pat_id": "US-8776522-B2", "para_id": "para_1", "text": "the contaminants may be removed from the heat exchanger in a generally non-invasive manner by periodically discharging water with the highly concentrated contaminants from a bottom drain of the heat exchanger (e.g., blow-down, blow-by, etc.) and directing the water to a containment location (e.g., evaporation pond or heat exchanger, storage tank etc.)"}, {"pat_id": "US-5736059-A", "para_id": "para_1", "text": "the tank must therefore drain away into the lower heat exchanger and thence to the sewer when there is no wastewater flow, leaving the upper heat exchanger high and dry protecting the fresh water supply from contamination"}]</data>
