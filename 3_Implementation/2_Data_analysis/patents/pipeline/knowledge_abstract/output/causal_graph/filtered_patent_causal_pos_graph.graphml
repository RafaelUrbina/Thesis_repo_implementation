  <data key="d7">[{"pat_id": "EP-1218293-B1", "para_id": "para_9", "text": "this ensures that the outgoing treated water 19 no longer has a temperature which can cause bicarbonate decomposition and solid deposition within the heat exchanger 18"}, {"pat_id": "EP-1228003-B1", "para_id": "para_9", "text": "this ensures that the outgoing treated water 19 no longer has a temperature which can cause bicarbonate decomposition and solid deposition within the heat exchanger 18"}, {"pat_id": "US-5776333-A", "para_id": "para_1", "text": "this ensures that the outgoing treated water 19 no longer has a temperature which can cause bicarbonate decomposition and solid deposition within the heat exchanger 18"}, {"pat_id": "US-5858248-A", "para_id": "para_1", "text": "this ensures that the outgoing treated water 19 no longer has a temperature which can cause bicarbonate decomposition and solid deposition within the heat exchanger 18"}, {"pat_id": "US-8741100-B2", "para_id": "para_1", "text": "where feed streams contain certain compounds such as carbonates for which solubility decreases with increasing temperature, deposits, generally known as boiler scale, will form even at relatively low concentrations due to the elevated temperatures at the surfaces of the heat exchangers"}]</data>
