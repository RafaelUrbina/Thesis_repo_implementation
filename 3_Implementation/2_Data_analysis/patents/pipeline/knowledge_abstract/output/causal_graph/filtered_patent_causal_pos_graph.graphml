  <data key="d1">11</data>
  <data key="d2">cause</data>
  <data key="d3">["US-6725717-B2", "US-10704740-B2"]</data>
  <data key="d4">["therefore", "increase", "remove", "receive", "thereby", "produce", "cause"]</data>
  <data key="d5">["embodiment", "pipeline", "site", "resistance", "direction", "vibration", "substance", "blockage", "case", "position", "downstream", "surface", "pressure", "coating", "gauge", "test", "outlet", "outside", "side", "change", "impact", "output", "block", "strain", "system", "presence", "leak", "stream"]</data>
  <data key="d6">["ascertain", "increase", "select", "detect", "remove", "direct", "gauge", "generate", "produce", "indicate", "repair", "use", "be", "receive", "relate", "fix", "bond", "mimic", "transmit", "lower", "determine", "simulate", "leak", "cause"]</data>
  <data key="d7">[{"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "specific embodiments relate to directing a fluid stream through an outlet at an outer surface of the pipeline to cause a vibration in the pipeline which simulates a leak in the pipeline"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "the impact of the fluid stream on the outer surface of the pipeline 4 causes a vibration in the pipeline which mimics the vibration caused by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "in any case, the vibration caused by the fluid stream mimics the vibration caused by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "therefore, the thermal change in the pipeline 4 generated by directing a fluid stream onto the pipeline 4 can be used to simulate the thermal change caused by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "in an embodiment, therefore, the system 2 can be used to selectively direct a fluid stream at the outer surface of the pipeline 4 to cause a vibration and/or a thermal change in the pipeline 4 which mimics the vibration and/or the thermal change produced by a leak in the pipeline 4"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "in an embodiment, at block 306, the fluid stream received in block 304 is output through the outlet which was fixed to the pipeline in block 302"}, {"pat_id": "US-10704740-B2", "para_id": "para_1", "text": "therefore, the vibration caused by the fluid stream may more accurately mimic the vibration caused by the substance leaking from the pipeline"}, {"pat_id": "US-6725717-B2", "para_id": "para_1", "text": "detecting by the strain gauge the presence of any strain changes in the pipeline at the selected position caused by the pressure changes and determining therefrom whether the blockage is upstream or downstream of the selected position"}, {"pat_id": "US-6725717-B2", "para_id": "para_1", "text": "by using very sensitive but readily available bonded resistance strain gauges , it can determine if there are pressure changes in the pipeline, thereby indicating whether there is blockage upstream or downstream of the test site"}, {"pat_id": "US-6725717-B2", "para_id": "para_1", "text": "once the direction of the blockage has been ascertained, that is whether the strain gauge is upstream or downstream of the blockage, the gauge can be removed from the outside of the pipeline and the pipeline s external coating repaired (if necessary)"}, {"pat_id": "US-6725717-B2", "para_id": "para_1", "text": "pressures in the pipeline on an upstream side 9 of the blockage can be increased or lowered but do not readily transmit or do not transmit at all to the down stream side 12 of the blockage"}]</data>
</edge>
